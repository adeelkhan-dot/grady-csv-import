# Local Compose Postgres (see compose.yaml). Copy to .env.local for next dev.
DATABASE_URL=postgres://grady:grady@127.0.0.1:5432/grady

# Seeded operator (no sign-up UI). Used by `npm run db:seed`.
SEED_OPERATOR_EMAIL=operator@example.com
SEED_OPERATOR_PASSWORD=test-password

# Signed HTTP-only session cookie.
SESSION_SECRET=change-me-to-a-long-random-string

# Local disk for uploaded CSVs (unique job-id names, not original filenames).
UPLOAD_DIR=data/uploads
